# Куда make-release.sh выкладывает готовую версию.
# Скопируйте в scripts/release.env и заполните своими значениями.
# release.env не отслеживается git.

DICTOR_RELEASE_HOST=my-server        # SSH-хост или алиас из ~/.ssh/config
DICTOR_RELEASE_DIR=/srv/dictor       # каталог на сервере
DICTOR_CHANNEL_URL=https://example.com  # адрес канала обновлений

# Где на сервере лежит накопленная статистика канала и как называется
# контейнер — нужны только для ./scripts/channel-stats.sh.
DICTOR_CHANNEL_CONTAINER=dictor-updates
DICTOR_STATS_DIR=/opt/dictor-stats
